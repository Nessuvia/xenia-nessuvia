#!/bin/sh
# Bump the patch version when pushing to dev, so the live build carries a new number.
# the bump commit is NOT part of the push that triggers it -- git has already
# resolved the ref by the time pre-push runs. It rides along on the next push, so the
# deployed version trails by one push. Move the bump into a deploy script if that matters.

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/dev" ] || continue
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac  # branch delete, nothing to bump

  npm version patch --no-git-tag-version >/dev/null || exit 1
  git add package.json package-lock.json 2>/dev/null || git add package.json
  git commit -m "v$(node -p "require('./package.json').version")" >/dev/null
  echo "pre-push: bumped to v$(node -p "require('./package.json').version") (lands on your next push)"
  break
done

exit 0
