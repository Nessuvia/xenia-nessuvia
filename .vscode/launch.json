{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vite Dev Server",
      "type": "node-terminal",
      "command": "npx pnpm dev",
      "request": "launch"
    },
    {
      "name": "Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Debug React App",
      "configurations": [
        "Vite Dev Server",
        "Chrome"
      ]
    }
  ]
}
